# 服务器配置
PORT=3000
NODE_ENV=production

# MongoDB 数据库连接（从 MongoDB Atlas 获取）
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/class-points?retryWrites=true&w=majority

# JWT 密钥（随机生成，保密！）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 跨域配置（前端地址）
FRONTEND_URL=https://your-frontend.vercel.app

# 文件上传限制（MB）
MAX_FILE_SIZE=5
