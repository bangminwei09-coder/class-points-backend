# MongoDB 数据库连接字符串
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT 密钥（请使用随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT 过期时间（格式：7d = 7天，24h = 24小时，60 = 60秒）
JWT_EXPIRES_IN=7d

# 前端URL（用于CORS配置）
FRONTEND_URL=https://class-points-frontend.vercel.app

# 服务器端口
PORT=3000

# Node环境
NODE_ENV=production
